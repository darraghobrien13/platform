# Local tooling for this repo. Install everything with: brew bundle
# Versions of OpenTofu and Node are pinned separately in mise.toml so CI and laptop match.

brew "mise"         # per-repo tool versions (OpenTofu, Node, tflint, gitleaks, pre-commit)
brew "gh"           # GitHub CLI
brew "scw"          # Scaleway CLI
brew "trivy"        # IaC + container vulnerability scanning
brew "jq"           # JSON on the command line
brew "colima"       # open-source container runtime (Linux VM)
brew "docker"       # docker CLI (talks to Colima)
brew "docker-buildx"
